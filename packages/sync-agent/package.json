{
	"name": "@jingles/sync-agent",
	"version": "1.0.0",
	"private": true,
	"description": "Desktop agent that syncs the legacy POS database (MSSQL/MySQL) into the Jingles inventory system every few minutes.",
	"main": "dist/index.js",
	"bin": {
		"jingles-sync-agent": "dist/index.js"
	},
	"scripts": {
		"build": "tsc",
		"dev": "ts-node src/index.ts",
		"start": "node dist/index.js",
		"once": "node dist/index.js --once",
		"test": "vitest run"
	},
	"dependencies": {
		"mssql": "^11.0.1",
		"mysql2": "^3.11.0"
	},
	"devDependencies": {
		"@jingles/shared": "*",
		"@types/mssql": "^9.1.5",
		"@types/node": "^20.10.6",
		"ts-node": "^10.9.2",
		"typescript": "^5.3.3",
		"vitest": "^4.1.0"
	}
}
