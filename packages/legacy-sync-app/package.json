{
	"name": "@jingles/legacy-sync-app",
	"version": "1.1.1",
	"private": true,
	"description": "Standalone desktop app that syncs the legacy POS database (MSSQL) into the Jingles inventory system every 5 minutes.",
	"author": "The Red Sun",
	"main": "dist/main.js",
	"scripts": {
		"build": "tsc",
		"start": "npm run build && electron .",
		"dev": "npm run build && electron .",
		"dist:win": "npm run build && electron-builder --win",
		"dist:update": "npm run build && node scripts/build-update.cjs JINGLES_LEGACY_SYNC_UPDATE_URL",
		"test": "echo \"no tests\" && exit 0"
	},
	"dependencies": {
		"electron-updater": "^6.8.9",
		"mssql": "^11.0.1",
		"mysql2": "^3.11.0"
	},
	"devDependencies": {
		"@jingles/shared": "*",
		"@types/node": "^20.10.6",
		"electron": "^43.2.0",
		"electron-builder": "^26.8.1",
		"typescript": "^5.3.3"
	},
	"build": {
		"appId": "com.jingles.legacysync",
		"productName": "Jingles Legacy Sync",
		"copyright": "Copyright © 2026 The Red Sun",
		"electronVersion": "38.8.6",
		"directories": {
			"output": "release"
		},
		"files": [
			"dist/**/*",
			"ui/**/*",
			"package.json"
		],
		"win": {
			"signtoolOptions": {
				"publisherName": "The Red Sun"
			},
			"target": [
				"nsis",
				"portable"
			]
		},
		"publish": [
			{
				"provider": "generic",
				"url": "https://inv.theredsun.org/updates/legacy-sync",
				"channel": "latest"
			}
		],
		"nsis": {
			"oneClick": true,
			"perMachine": false
		}
	}
}
