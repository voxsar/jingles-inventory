{
	"name": "@jingles/backend",
	"version": "1.0.2",
	"main": "dist/server.js",
	"scripts": {
		"dev": "node ../../scripts/write-build-info.mjs backend && ts-node-dev --respawn --transpile-only src/server.ts",
		"build": "node ../../scripts/write-build-info.mjs backend && node scripts/generate-local-prisma.mjs && prisma generate && tsc",
		"start": "node dist/server.js",
		"deploy": "node ../../scripts/write-build-info.mjs backend && prisma migrate deploy && prisma generate && tsc && pm2 restart jingles-backend",
		"prisma:generate": "node scripts/generate-local-prisma.mjs && prisma generate",
		"prisma:generate:local": "node scripts/generate-local-prisma.mjs",
		"prisma:migrate": "prisma migrate dev",
		"prisma:seed": "ts-node src/prisma/seed.ts",
		"prisma:seed-stress": "ts-node src/prisma/seed-stress.ts",
		"import:recovered-catalog": "ts-node src/scripts/importRecoveredCatalog.ts",
		"catalog:consolidate-variants": "ts-node src/scripts/consolidateClearVariantFamilies.ts",
		"restore:catalog-defaults": "ts-node src/scripts/restoreCatalogDefaults.ts",
		"test": "node ../../scripts/write-build-info.mjs backend && vitest run",
		"test:watch": "node ../../scripts/write-build-info.mjs backend && vitest",
		"test:coverage": "node ../../scripts/write-build-info.mjs backend && vitest run --coverage"
	},
	"dependencies": {
		"@jingles/shared": "*",
		"@prisma/client": "^5.7.1",
		"bcryptjs": "^2.4.3",
		"cors": "^2.8.5",
		"dotenv": "^16.3.1",
		"express": "^4.18.2",
		"express-rate-limit": "^8.3.1",
		"express-validator": "^7.0.1",
		"jsonwebtoken": "^9.0.2",
		"multer": "^2.1.1",
		"pg": "^8.21.0",
		"typesense": "^3.0.3",
		"uuid": "^9.0.0",
		"winston": "^3.11.0",
		"ws": "^8.20.1",
		"xlsx": "^0.18.5"
	},
	"devDependencies": {
		"@types/bcryptjs": "^2.4.6",
		"@types/cors": "^2.8.17",
		"@types/express": "^4.17.21",
		"@types/express-rate-limit": "^5.1.3",
		"@types/jsonwebtoken": "^9.0.5",
		"@types/multer": "^1.4.11",
		"@types/node": "^20.10.6",
		"@types/pg": "^8.20.0",
		"@types/supertest": "^7.2.0",
		"@types/uuid": "^9.0.7",
		"@types/ws": "^8.18.1",
		"@vitest/coverage-v8": "^4.1.0",
		"prisma": "^5.7.1",
		"supertest": "^7.2.2",
		"ts-node": "^10.9.2",
		"ts-node-dev": "^2.0.0",
		"typescript": "^5.3.3",
		"vitest": "^4.1.0"
	}
}
