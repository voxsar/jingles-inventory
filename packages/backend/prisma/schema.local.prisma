generator client {
  provider = "prisma-client-js"
  output   = "../generated/local-prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("LOCAL_SQLITE_DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  pinHash      String?  @map("pin_hash")
  role         String
  vendorId     String?  @map("vendor_id")
  createdAt    DateTime @default(now()) @map("created_at")
  isActive     Boolean  @default(true) @map("is_active")

  vendor                   Vendor?                   @relation(fields: [vendorId], references: [id])
  inventoryRecords         InventoryRecord[]
  inventoryEvents          InventoryEvent[]
  grns                     GRN[]
  prns                     PRN[]
  inspectionRecords        InspectionRecord[]
  auditLogs                AuditLog[]
  importJobs               ImportJob[]
  stockTransfersCreated    StockTransfer[]           @relation("StockTransferCreator")
  stockTransfersApproved   StockTransfer[]           @relation("StockTransferApprover")
  voucherBatches           VoucherBatch[]
  voucherCodes             VoucherCode[]
  voucherRedemptions       VoucherRedemption[]
  stockCountRunsStarted    StockCountRun[]           @relation("StockCountRunStartedBy")
  stockCountRunsCompleted  StockCountRun[]           @relation("StockCountRunCompletedBy")
  stockCountDeviceSessions StockCountDeviceSession[]
  stockCountLines          StockCountLine[]
  stockCountSubmissions    StockCountSubmission[]
  barcodePrintTemplates    BarcodePrintTemplate[]
  barcodePrintJobs         BarcodePrintJob[]

  @@map("users")
}

model Vendor {
  id           String   @id @default(uuid())
  name         String   @unique
  contactEmail String   @map("contact_email")
  contactPhone String?  @map("contact_phone")
  address      String?
  type         String   @default("Vendor") @map("type")
  website      String?
  taxId        String?  @map("tax_id")
  paymentTerms String?  @map("payment_terms")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  isActive     Boolean  @default(true) @map("is_active")

  users      User[]
  skus       SKU[]
  grns       GRN[]
  prns       PRN[]
  skuVendors SKUVendor[]
  batches    Batch[]

  @@map("vendors")
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  parentId    String?  @map("parent_id")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  skus     SKU[]

  @@map("categories")
}

model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String?
  createdAt DateTime @default(now()) @map("created_at")

  skus SKUTag[]

  @@map("tags")
}

model UnitOfMeasure {
  id               String   @id @default(uuid())
  name             String   @unique
  abbreviation     String
  baseUnit         String?  @map("base_unit")
  conversionFactor Float?   @map("conversion_factor")
  type             String
  isActive         Boolean  @default(true) @map("is_active")
  isSystem         Boolean  @default(false) @map("is_system")
  createdAt        DateTime @default(now()) @map("created_at")

  skus SKU[]

  @@map("units_of_measure")
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  address   String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true) @map("is_active")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  floors             Floor[]
  stockTransfersFrom StockTransfer[]     @relation("StockTransferFrom")
  stockTransfersTo   StockTransfer[]     @relation("StockTransferTo")
  voucherRedemptions VoucherRedemption[]
  stockCountRuns     StockCountRun[]

  @@map("branches")
}

model SKU {
  id              String  @id @default(uuid())
  skuCode         String  @unique @map("sku_code")
  name            String
  description     String?
  categoryId      String? @map("category_id")
  vendorId        String  @map("vendor_id")
  unitOfMeasureId String? @map("unit_of_measure_id")
  unitOfMeasure   String  @map("unit_of_measure")
  conversionRules String?   @map("conversion_rules")
  dimensions      String?
  videoUrl        String? @map("video_url")
  isFragile       Boolean @default(false) @map("is_fragile")
  maxStackHeight  Float?  @map("max_stack_height")

  // Default pricing fields (used as fallback when no batch-specific price exists)
  costPrice      Float?  @map("cost_price")
  sellingPrice   Float?  @map("selling_price")
  wholesalePrice Float?  @map("wholesale_price")
  bulkPrice      Float?  @map("bulk_price")
  marginType     String? @map("margin_type") // 'fixed' or 'percentage'
  marginValue    Float?  @map("margin_value") // Amount or %
  currency       String  @default("LKR")

  // Default date fields (used as fallback for batches)
  defaultManufacturingDate DateTime? @map("default_manufacturing_date") // Default manufacture date
  defaultExpiryDate        DateTime? @map("default_expiry_date") // Default expiry date
  shelfLifeDays            Int?      @map("shelf_life_days") // Days between manufacture and expiry

  batchPricing          String? @map("batch_pricing")
  batchReferencePricing String? @map("batch_reference_pricing")
  lowStockThreshold     Int?  @map("low_stock_threshold")

  // Voucher-specific fields
  isVoucher        Boolean @default(false) @map("is_voucher")
  voucherValueType String? @map("voucher_value_type") // 'fixed' or 'range'
  voucherMinValue  Decimal? @map("voucher_min_value")
  voucherMaxValue  Decimal? @map("voucher_max_value")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vendor                Vendor                 @relation(fields: [vendorId], references: [id])
  category              Category?              @relation(fields: [categoryId], references: [id])
  unitModel             UnitOfMeasure?         @relation(fields: [unitOfMeasureId], references: [id])
  inventoryRecords      InventoryRecord[]
  grnLines              GRNLine[]
  prnLines              PRNLine[]
  images                ProductImage[]
  barcodes              ProductBarcode[]
  tags                  SKUTag[]
  skuAttributes         SKUAttribute[]
  variants              SKUVariant[]
  batches               Batch[]
  stockTransferLines    StockTransferLine[]
  skuVendors            SKUVendor[]
  voucherCodes          VoucherCode[]
  voucherRestrictions   VoucherRestriction[]
  voucherBatches        VoucherBatch[]
  stockCountItems       StockCountItem[]
  stockCountSubmissions StockCountSubmission[]
  barcodePrintJobItems  BarcodePrintJobItem[]

  @@map("skus")
}

model SKUVendor {
  skuId    String @map("sku_id")
  vendorId String @map("vendor_id")

  sku    SKU    @relation(fields: [skuId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@id([skuId, vendorId])
  @@map("sku_vendors")
}

model SKUTag {
  skuId String @map("sku_id")
  tagId String @map("tag_id")

  sku SKU @relation(fields: [skuId], references: [id], onDelete: Cascade)
  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([skuId, tagId])
  @@map("sku_tags")
}

// ── Global Attribute System ────────────────────────────────

model Attribute {
  id        String   @id @default(uuid())
  name      String   @unique
  type      String   @default("dropdown") // dropdown | text | numeric | boolean | color
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  values        AttributeValue[]
  skuAttributes SKUAttribute[]
  variantValues SKUVariantValue[]

  @@map("attributes")
}

model AttributeValue {
  id               String   @id @default(uuid())
  attributeId      String   @map("attribute_id")
  displayName      String   @map("display_name")
  representedValue String   @map("represented_value")
  sortOrder        Int      @default(0) @map("sort_order")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")

  attribute          Attribute           @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variantValues      SKUVariantValue[]
  skuAttributeValues SKUAttributeValue[]

  @@unique([attributeId, representedValue])
  @@map("attribute_values")
}

// Which attributes are assigned to a product (SKU)
model SKUAttribute {
  id          String @id @default(uuid())
  skuId       String @map("sku_id")
  attributeId String @map("attribute_id")

  sku            SKU                 @relation(fields: [skuId], references: [id], onDelete: Cascade)
  attribute      Attribute           @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  selectedValues SKUAttributeValue[]

  @@unique([skuId, attributeId])
  @@map("sku_attributes")
}

// Which specific values of each attribute are selected for a product
model SKUAttributeValue {
  skuAttributeId   String @map("sku_attribute_id")
  attributeValueId String @map("attribute_value_id")

  skuAttribute   SKUAttribute   @relation(fields: [skuAttributeId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([skuAttributeId, attributeValueId])
  @@map("sku_attribute_values")
}

// Each SKU variant = a unique combination of attribute values
model SKUVariant {
  id          String   @id @default(uuid())
  skuId       String   @map("sku_id")
  variantCode String   @unique @map("variant_code")
  name        String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sku                   SKU                    @relation(fields: [skuId], references: [id], onDelete: Cascade)
  attributeValues       SKUVariantValue[]
  inventoryRecords      InventoryRecord[]
  grnLines              GRNLine[]
  prnLines              PRNLine[]
  batches               Batch[]
  stockTransferLines    StockTransferLine[]
  images                ProductImage[]
  barcodes              ProductBarcode[]
  voucherCodes          VoucherCode[]
  voucherBatches        VoucherBatch[]
  stockCountItems       StockCountItem[]
  stockCountSubmissions StockCountSubmission[]
  barcodePrintJobItems  BarcodePrintJobItem[]

  @@map("sku_variants")
}

// Links a variant to its specific attribute values (one row per attribute)
model SKUVariantValue {
  variantId        String @map("variant_id")
  attributeId      String @map("attribute_id")
  attributeValueId String @map("attribute_value_id")

  variant        SKUVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute      Attribute      @relation(fields: [attributeId], references: [id])
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id])

  @@id([variantId, attributeId])
  @@map("sku_variant_values")
}

model ProductImage {
  id        String   @id @default(uuid())
  skuId     String   @map("sku_id")
  variantId String?  @map("variant_id")
  url       String
  altText   String?  @map("alt_text")
  isPrimary Boolean  @default(false) @map("is_primary")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  sku     SKU         @relation(fields: [skuId], references: [id], onDelete: Cascade)
  variant SKUVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([skuId, variantId, sortOrder])
  @@map("product_images")
}

model ProductBarcode {
  id          String   @id @default(uuid())
  skuId       String   @map("sku_id")
  variantId   String?  @map("variant_id")
  barcode     String   @unique
  barcodeType String   @default("EAN13") @map("barcode_type")
  isDefault   Boolean  @default(false) @map("is_default")
  label       String?
  createdAt   DateTime @default(now()) @map("created_at")

  sku           SKU                   @relation(fields: [skuId], references: [id], onDelete: Cascade)
  variant       SKUVariant?           @relation(fields: [variantId], references: [id], onDelete: Cascade)
  printJobItems BarcodePrintJobItem[]

  @@index([skuId, variantId, isDefault])
  @@map("product_barcodes")
}

model BarcodePrintTemplate {
  id                String   @id @default(uuid())
  name              String   @unique
  description       String?
  pageWidthMm       Float    @default(210) @map("page_width_mm")
  pageHeightMm      Float    @default(297) @map("page_height_mm")
  marginTopMm       Float    @default(8) @map("margin_top_mm")
  marginRightMm     Float    @default(8) @map("margin_right_mm")
  marginBottomMm    Float    @default(8) @map("margin_bottom_mm")
  marginLeftMm      Float    @default(8) @map("margin_left_mm")
  columns           Int      @default(3)
  rows              Int      @default(8)
  labelWidthMm      Float    @default(62) @map("label_width_mm")
  labelHeightMm     Float    @default(34) @map("label_height_mm")
  gapXMm            Float    @default(2) @map("gap_x_mm")
  gapYMm            Float    @default(2) @map("gap_y_mm")
  paddingTopMm      Float    @default(2) @map("padding_top_mm")
  paddingRightMm    Float    @default(2) @map("padding_right_mm")
  paddingBottomMm   Float    @default(2) @map("padding_bottom_mm")
  paddingLeftMm     Float    @default(2) @map("padding_left_mm")
  barcodeHeightMm   Float    @default(14) @map("barcode_height_mm")
  barcodeFormat     String   @default("CODE128") @map("barcode_format")
  showProductName   Boolean  @default(true) @map("show_product_name")
  showVariantName   Boolean  @default(true) @map("show_variant_name")
  showPrice         Boolean  @default(true) @map("show_price")
  showSkuCode       Boolean  @default(false) @map("show_sku_code")
  showBarcodeNumber Boolean  @default(true) @map("show_barcode_number")
  isDefault         Boolean  @default(false) @map("is_default")
  printCount        Int      @default(0) @map("print_count")
  createdById       String?  @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  creator User?             @relation(fields: [createdById], references: [id])
  jobs    BarcodePrintJob[]

  @@map("barcode_print_templates")
}

model BarcodePrintJob {
  id            String    @id @default(uuid())
  templateId    String?   @map("template_id")
  sourceType    String    @default("MANUAL") @map("source_type")
  grnId         String?   @map("grn_id")
  status        String    @default("DRAFT")
  totalCopies   Int       @default(0) @map("total_copies")
  printedCount  Int       @default(0) @map("printed_count")
  printRunCount Int       @default(0) @map("print_run_count")
  createdById   String?   @map("created_by")
  printedAt     DateTime? @map("printed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  template BarcodePrintTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  grn      GRN?                  @relation(fields: [grnId], references: [id], onDelete: SetNull)
  creator  User?                 @relation(fields: [createdById], references: [id])
  items    BarcodePrintJobItem[]

  @@index([sourceType, createdAt])
  @@index([grnId])
  @@map("barcode_print_jobs")
}

model BarcodePrintJobItem {
  id                  String   @id @default(uuid())
  jobId               String   @map("job_id")
  skuId               String   @map("sku_id")
  variantId           String?  @map("variant_id")
  barcodeId           String?  @map("barcode_id")
  barcodeSnapshot     String   @map("barcode_snapshot")
  productNameSnapshot String   @map("product_name_snapshot")
  variantNameSnapshot String?  @map("variant_name_snapshot")
  skuCodeSnapshot     String   @map("sku_code_snapshot")
  priceSnapshot       Decimal? @map("price_snapshot")
  copies              Int
  printedCount        Int      @default(0) @map("printed_count")
  createdAt           DateTime @default(now()) @map("created_at")

  job     BarcodePrintJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sku     SKU             @relation(fields: [skuId], references: [id])
  variant SKUVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)
  barcode ProductBarcode? @relation(fields: [barcodeId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([skuId, variantId])
  @@map("barcode_print_job_items")
}

model Floor {
  id          String   @id @default(uuid())
  branchId    String   @map("branch_id")
  name        String
  code        String
  floorNumber Int      @map("floor_number")
  length      Float? // in meters
  width       Float? // in meters
  notes       String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  branch             Branch                    @relation(fields: [branchId], references: [id])
  racks              Rack[]
  shelves            Shelf[]
  boxes              StorageBox[]
  inventoryRecords   InventoryRecord[]
  grns               GRN[]
  prns               PRN[]
  transfersFrom      StockTransfer[]           @relation("StockTransferFromFloor")
  transfersTo        StockTransfer[]           @relation("StockTransferToFloor")
  stockCountSessions StockCountDeviceSession[]
  stockCountItems    StockCountItem[]

  @@unique([branchId, code])
  @@map("floors")
}

model Rack {
  id        String   @id @default(uuid())
  floorId   String   @map("floor_id")
  name      String
  code      String
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  // 3D layout position (metres) and rotation (degrees around Y axis)
  posX Float? @map("pos_x")
  posZ Float? @map("pos_z")
  rotY Float? @default(0) @map("rot_y")

  // Physical dimensions in cm
  widthCm  Float? @map("width_cm")
  heightCm Float? @map("height_cm")
  depthCm  Float? @map("depth_cm")

  floor   Floor   @relation(fields: [floorId], references: [id])
  shelves Shelf[]

  @@unique([floorId, code])
  @@map("racks")
}

model Shelf {
  id          String   @id @default(uuid())
  floorId     String   @map("floor_id")
  rackId      String?  @map("rack_id")
  name        String
  code        String
  // Physical dimensions in centimetres.
  height      Float
  width       Float
  length      Float
  // Explicit vertical placement inside a rack. elevationCm is the board's top
  // above the floor; levelIndex provides stable bottom-to-top ordering.
  levelIndex  Int?     @map("level_index")
  elevationCm Float?   @map("elevation_cm")
  hasFreezer  Boolean  @default(false) @map("has_freezer")
  hasLock     Boolean  @default(false) @map("has_lock")
  notes       String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  floor              Floor                     @relation(fields: [floorId], references: [id])
  rack               Rack?                     @relation(fields: [rackId], references: [id])
  boxes              StorageBox[]
  inventoryRecords   InventoryRecord[]
  grns               GRN[]
  prns               PRN[]
  stockCountSessions StockCountDeviceSession[]
  stockCountItems    StockCountItem[]

  @@unique([floorId, code])
  @@map("shelves")
}

model StorageBox {
  id        String   @id @default(uuid())
  shelfId   String?  @map("shelf_id")
  floorId   String?  @map("floor_id")
  name      String
  code      String   @unique
  // Physical dimensions in centimetres.
  height    Float
  width     Float
  length    Float
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  // 3D position/orientation within its parent space (metres / degrees)
  posX          Float? @map("pos_x")
  posY          Float? @map("pos_y")
  posZ          Float? @map("pos_z")
  rotationAngle Float? @default(0) @map("rotation_angle")

  // Stacking support
  stackOrder  Int?    @default(0) @map("stack_order")
  parentBoxId String? @map("parent_box_id")

  shelf            Shelf?            @relation(fields: [shelfId], references: [id])
  floor            Floor?            @relation(fields: [floorId], references: [id])
  parentBox        StorageBox?       @relation("BoxStacking", fields: [parentBoxId], references: [id])
  stackedBoxes     StorageBox[]      @relation("BoxStacking")
  barcodes         BoxBarcode[]
  inventoryRecords InventoryRecord[]

  @@map("storage_boxes")
}

model BoxBarcode {
  id          String   @id @default(uuid())
  boxId       String   @map("box_id")
  barcode     String   @unique
  barcodeType String   @default("EAN13") @map("barcode_type")
  isDefault   Boolean  @default(false) @map("is_default")
  label       String?
  createdAt   DateTime @default(now()) @map("created_at")

  box StorageBox @relation(fields: [boxId], references: [id], onDelete: Cascade)

  @@map("box_barcodes")
}

model StockTransfer {
  id              String    @id @default(uuid())
  referenceNumber String    @unique @map("reference_number")
  fromBranchId    String?   @map("from_branch_id")
  toBranchId      String?   @map("to_branch_id")
  fromFloorId     String?   @map("from_floor_id")
  toFloorId       String?   @map("to_floor_id")
  status          String    @default("Draft")
  notes           String?
  requestedBy     String    @map("requested_by")
  approvedBy      String?   @map("approved_by")
  requestedAt     DateTime  @default(now()) @map("requested_at")
  approvedAt      DateTime? @map("approved_at")
  completedAt     DateTime? @map("completed_at")

  fromBranch Branch?             @relation("StockTransferFrom", fields: [fromBranchId], references: [id])
  toBranch   Branch?             @relation("StockTransferTo", fields: [toBranchId], references: [id])
  fromFloor  Floor?              @relation("StockTransferFromFloor", fields: [fromFloorId], references: [id])
  toFloor    Floor?              @relation("StockTransferToFloor", fields: [toFloorId], references: [id])
  requester  User                @relation("StockTransferCreator", fields: [requestedBy], references: [id])
  approver   User?               @relation("StockTransferApprover", fields: [approvedBy], references: [id])
  lines      StockTransferLine[]

  @@map("stock_transfers")
}

model StockTransferLine {
  id             String  @id @default(uuid())
  transferId     String  @map("transfer_id")
  skuId          String  @map("sku_id")
  variantId      String? @map("variant_id")
  batchId        String? @map("batch_id")
  requestedQty   Int     @map("requested_qty")
  transferredQty Int     @default(0) @map("transferred_qty")
  notes          String?

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  sku      SKU           @relation(fields: [skuId], references: [id])
  variant  SKUVariant?   @relation(fields: [variantId], references: [id])
  batch    Batch?        @relation(fields: [batchId], references: [id])

  @@unique([transferId, skuId, variantId, batchId])
  @@map("stock_transfer_lines")
}

model InventoryRecord {
  id            String   @id @default(uuid())
  skuId         String   @map("sku_id")
  variantId     String?  @map("variant_id")
  batchId       String?  @map("batch_id")
  floorId       String?  @map("floor_id")
  shelfId       String?  @map("shelf_id")
  boxId         String?  @map("box_id")
  quantity      Float
  state         String
  // Optional physical placement within the selected floor/shelf/box (metres).
  posX          Float?   @map("pos_x")
  posY          Float?   @map("pos_y")
  posZ          Float?   @map("pos_z")
  rotY          Float?   @default(0) @map("rot_y")
  sourceEventId String?  @map("source_event_id")
  terminalId    String?  @map("terminal_id")
  userId        String?  @map("user_id")
  version       Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sku             SKU              @relation(fields: [skuId], references: [id])
  variant         SKUVariant?      @relation(fields: [variantId], references: [id])
  batch           Batch?           @relation(fields: [batchId], references: [id])
  floor           Floor?           @relation(fields: [floorId], references: [id])
  shelf           Shelf?           @relation(fields: [shelfId], references: [id])
  box             StorageBox?      @relation(fields: [boxId], references: [id])
  user            User?            @relation(fields: [userId], references: [id])
