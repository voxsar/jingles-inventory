  @@index([code])
  @@index([skuId, variantId], map: "voucher_codes_sku_variant_idx")
  @@index([status])
  @@index([expiresAt])
  @@index([voucherBatchId], map: "voucher_codes_batch_idx")
  @@map("voucher_codes")
}

model VoucherRedemption {
  id             String   @id @default(uuid())
  voucherCodeId  String   @map("voucher_code_id")
  code           String
  redeemedAmount Decimal  @map("redeemed_amount")
  balanceBefore  Decimal  @map("balance_before")
  balanceAfter   Decimal  @map("balance_after")
  orderId        String?  @map("order_id")
  invoiceNumber  String?  @map("invoice_number")
  branchId       String?  @map("branch_id")
  appliedToItems String?    @map("applied_to_items") // Array of {skuId, variantId, quantity, originalPrice, discountedPrice}
  redeemedBy     String?  @map("redeemed_by")
  redeemedAt     DateTime @default(now()) @map("redeemed_at")
  notes          String?

  voucherCode VoucherCode @relation(fields: [voucherCodeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  branch      Branch?     @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  redeemer    User?       @relation(fields: [redeemedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([voucherCodeId])
  @@index([code])
  @@index([redeemedAt])
  @@index([branchId])
  @@map("voucher_redemptions")
}

// ── Legacy Desktop Sync ───────────────────────────────────────
// Persistent mapping between rows in the legacy POS database and entities in
// this system. Once a legacy product is linked to a SKU variant (because it
// was merged into a variant family), every future sync keeps writing to that
// variant — the link is the source of truth, not the legacy schema shape.

model LegacyEntityLink {
  id          String    @id @default(uuid())
  sourceType  String    @map("source_type") // 'product' | 'productcolorsize' | 'supplier' | 'location' | 'unit'
  sourceId    String    @map("source_id") // legacy primary key, as string
  sourceCode  String?   @map("source_code") // ProductCode / SupplierCode / LocationCode ...
  targetType  String    @map("target_type") // 'sku' | 'variant' | 'vendor' | 'branch' | 'unit'
  targetId    String    @map("target_id")
  resolution  String    @default("auto") // 'sku-code' | 'variant-code' | 'barcode' | 'name' | 'created' | 'manual'
  isLocked    Boolean   @default(false) @map("is_locked") // manual links are never re-resolved
  lastApplied String?     @map("last_applied") // last legacy values applied (3-way merge base)
  lastSeenAt  DateTime? @map("last_seen_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([sourceType, sourceId])
  @@index([targetType, targetId])
  @@map("legacy_entity_links")
}

model LegacySyncRun {
  id           String    @id @default(uuid())
  agentId      String?   @map("agent_id")
  status       String    @default("Running") // Running | Completed | CompletedWithWarnings | Failed
  startedAt    DateTime  @default(now()) @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  stats        String?
  errorMessage String?   @map("error_message")

  @@index([startedAt])
  @@map("legacy_sync_runs")
}

model LegacyPosRecord {
  sourceTable   String   @map("source_table")
  sourceId      String   @map("source_id")
  payload       String     @default("{}")
  firstSyncedAt DateTime @default(now()) @map("first_synced_at")
  lastSyncedAt  DateTime @default(now()) @map("last_synced_at")

  @@id([sourceTable, sourceId])
  @@index([sourceTable], map: "legacy_pos_records_table_idx")
  @@map("legacy_pos_records")
}

model LegacyPosRecordVersion {
  id          String   @id
  sourceTable String   @map("source_table")
  sourceId    String   @map("source_id")
  payload     String
  contentHash String   @map("content_hash")
  syncRunId   String   @map("sync_run_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([sourceTable, sourceId, contentHash])
  @@map("legacy_pos_record_versions")
}

model PosShift {
