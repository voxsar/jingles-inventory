model InventoryEvent {
  id             String   @id @default(uuid())
  eventType      String   @map("event_type")
  parentEntityId String?  @map("parent_entity_id")
  quantityDelta  Float?   @map("quantity_delta")
  beforeQuantity Float?   @map("before_quantity")
  afterQuantity  Float?   @map("after_quantity")
  reasonCode     String?  @map("reason_code")
  userId         String?  @map("user_id")
  terminalId     String?  @map("terminal_id")
  timestamp      DateTime @default(now())
  overrideFlag   Boolean  @default(false) @map("override_flag")
  metadata       String?

  user User? @relation(fields: [userId], references: [id])

  @@map("inventory_events")
}

// Singleton control for the authoritative inventory baseline. Once inventory
// is zeroed, legacy MaxSoft snapshots may continue syncing catalog data but
// can no longer overwrite quantities created by native workflows.
model InventoryControl {
  id                        String    @id
  legacyQuantitySyncEnabled Boolean   @default(true) @map("legacy_quantity_sync_enabled")
  zeroedAt                  DateTime? @map("zeroed_at")
  zeroedById                String?   @map("zeroed_by_id")
  zeroOperationId           String?   @map("zero_operation_id")
  recordsZeroed             Int       @default(0) @map("records_zeroed")
  unitsZeroed               Float     @default(0) @map("units_zeroed")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  @@map("inventory_control")
}

// Branch-wide stock count. Android devices add their counted quantities to
// the existing native stock baseline; they never zero stock.
model StockCountRun {
  id            String    @id @default(uuid())
  branchId      String    @map("branch_id")
  status        String    @default("OPEN")
  requestId     String    @unique @map("request_id")
  openBranchKey String?   @unique @map("open_branch_key")
  startedById   String    @map("started_by_id")
  completedById String?   @map("completed_by_id")
  startedAt     DateTime  @default(now()) @map("started_at")
  completedAt   DateTime? @map("completed_at")

  branch         Branch                    @relation(fields: [branchId], references: [id])
  startedBy      User                      @relation("StockCountRunStartedBy", fields: [startedById], references: [id])
  completedBy    User?                     @relation("StockCountRunCompletedBy", fields: [completedById], references: [id])
  deviceSessions StockCountDeviceSession[]
  items          StockCountItem[]

  @@index([branchId, status])
  @@map("stock_count_runs")
}

// One independent Android phone session within a branch-wide run.
model StockCountDeviceSession {
  id          String    @id @default(uuid())
  runId       String    @map("run_id")
  deviceId    String    @map("device_id")
  deviceName  String    @map("device_name")
  floorId     String    @map("floor_id")
  shelfId     String?   @map("shelf_id")
  status      String    @default("OPEN")
  startedById String    @map("started_by_id")
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  run         StockCountRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  floor       Floor                  @relation(fields: [floorId], references: [id])
  shelf       Shelf?                 @relation(fields: [shelfId], references: [id])
  startedBy   User                   @relation(fields: [startedById], references: [id])
  lines       StockCountLine[]
  submissions StockCountSubmission[]

  @@unique([runId, deviceId])
  @@index([deviceId, status])
  @@index([runId, status])
  @@map("stock_count_device_sessions")
}

// Shared aggregate for a product/variant at one configured location.
model StockCountItem {
  id                String   @id @default(uuid())
  runId             String   @map("run_id")
  skuId             String   @map("sku_id")
  variantId         String?  @map("variant_id")
  variantKey        String   @default("") @map("variant_key")
  floorId           String   @map("floor_id")
  shelfId           String?  @map("shelf_id")
  locationKey       String   @map("location_key")
  inventoryRecordId String   @map("inventory_record_id")
  quantity          Float    @default(0)
  updatedAt         DateTime @updatedAt @map("updated_at")

  run             StockCountRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  sku             SKU                    @relation(fields: [skuId], references: [id])
  variant         SKUVariant?            @relation(fields: [variantId], references: [id])
  floor           Floor                  @relation(fields: [floorId], references: [id])
  shelf           Shelf?                 @relation(fields: [shelfId], references: [id])
  inventoryRecord InventoryRecord        @relation(fields: [inventoryRecordId], references: [id])
  lines           StockCountLine[]
  submissions     StockCountSubmission[]

  @@unique([runId, skuId, variantKey, locationKey])
  @@index([inventoryRecordId])
  @@map("stock_count_items")
}

// Latest quantity assigned by one phone for one shared item.
model StockCountLine {
  id              String   @id @default(uuid())
  deviceSessionId String   @map("device_session_id")
  itemId          String   @map("item_id")
  quantity        Float
  lastBarcode     String?  @map("last_barcode")
  updatedById     String   @map("updated_by_id")
  countedAt       DateTime @default(now()) @map("counted_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  deviceSession StockCountDeviceSession @relation(fields: [deviceSessionId], references: [id], onDelete: Cascade)
  item          StockCountItem          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  updatedBy     User                    @relation(fields: [updatedById], references: [id])
  submissions   StockCountSubmission[]

  @@unique([deviceSessionId, itemId])
  @@index([itemId])
  @@map("stock_count_lines")
}

// Append-only idempotency and audit record for Android submissions.
model StockCountSubmission {
  id                String   @id @default(uuid())
  requestId         String   @unique @map("request_id")
  deviceSessionId   String   @map("device_session_id")
  itemId            String   @map("item_id")
  lineId            String   @map("line_id")
  skuId             String   @map("sku_id")
  variantId         String?  @map("variant_id")
  barcode           String?
  submittedQuantity Float    @map("submitted_quantity")
  deviceBefore      Float    @map("device_before")
  deviceAfter       Float    @map("device_after")
  totalAfter        Float    @map("total_after")
  submittedById     String   @map("submitted_by_id")
  createdAt         DateTime @default(now()) @map("created_at")

  deviceSession StockCountDeviceSession @relation(fields: [deviceSessionId], references: [id], onDelete: Cascade)
  item          StockCountItem          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  line          StockCountLine          @relation(fields: [lineId], references: [id], onDelete: Cascade)
  sku           SKU                     @relation(fields: [skuId], references: [id])
  variant       SKUVariant?             @relation(fields: [variantId], references: [id])
  submittedBy   User                    @relation(fields: [submittedById], references: [id])

  @@index([deviceSessionId, createdAt])
  @@index([itemId, createdAt])
  @@map("stock_count_submissions")
}

model GRN {
  id                   String    @id @default(uuid())
  supplierId           String    @map("supplier_id")
  floorId              String?   @map("floor_id")
  shelfId              String?   @map("shelf_id")
