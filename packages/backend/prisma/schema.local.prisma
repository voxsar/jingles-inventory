model ManagedDevice {
  id                 String    @id
  displayName        String    @map("display_name")
  reportedName       String    @map("reported_name")
  nameVersion        Int       @default(0) @map("name_version")
  application        String
  applicationVersion String    @map("application_version")
  platform           String?
  hostname           String?
  branchId           String?   @map("branch_id")
  terminalId         String?   @map("terminal_id")
  lastIp             String?   @map("last_ip")
  lastConnection     String?   @map("last_connection")
  lastSeenAt         DateTime  @default(now()) @map("last_seen_at")
  lastSyncAt         DateTime? @map("last_sync_at")
  pendingCount       Int       @default(0) @map("pending_count")
  conflictCount      Int       @default(0) @map("conflict_count")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([application, lastSeenAt])
  @@index([branchId])
  @@map("managed_devices")
}

model VoucherRestriction {
  id                             String   @id @default(uuid())
  skuId                          String   @map("sku_id")
  restrictionType                String   @map("restriction_type") // 'category_exclude', 'category_include', 'sku_exclude', 'sku_include', 'variant_exclude', 'variant_include'
  targetCategoryIds              String?    @map("target_category_ids") // Array of category IDs
  targetSkuIds                   String?    @map("target_sku_ids") // Array of SKU IDs
  targetVariantIds               String?    @map("target_variant_ids") // Array of variant IDs
  cannotCombineWithDiscounts     Boolean  @default(true) @map("cannot_combine_with_discounts")
  cannotCombineWithOtherVouchers Boolean  @default(true) @map("cannot_combine_with_other_vouchers")
  minPurchaseAmount              Decimal? @map("min_purchase_amount")
  maxDiscountAmount              Decimal? @map("max_discount_amount")
  priority                       Int      @default(0)
  createdAt                      DateTime @default(now()) @map("created_at")
  updatedAt                      DateTime @default(now()) @updatedAt @map("updated_at")

  sku SKU @relation(fields: [skuId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([skuId, restrictionType])
  @@index([skuId])
  @@index([restrictionType])
  @@map("voucher_restrictions")
}
