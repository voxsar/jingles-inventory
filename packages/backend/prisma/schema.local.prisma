model VoucherBatch {
  id               String    @id @default(uuid())
  skuId            String    @map("sku_id")
  variantId        String?   @map("variant_id")
  batchName        String    @map("batch_name")
  prefix           String?
  quantity         Int
  generatedCount   Int       @default(0) @map("generated_count")
  defaultValue     Decimal   @map("default_value")
  expiryDays       Int?      @map("expiry_days")
  defaultExpiresAt DateTime? @map("default_expires_at")
  status           String    @default("pending") // 'pending', 'generating', 'completed', 'failed'
