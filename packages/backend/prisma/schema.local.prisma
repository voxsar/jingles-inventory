}

model VoucherCode {
  id                String    @id @default(uuid())
  code              String    @unique
  skuId             String    @map("sku_id")
  variantId         String?   @map("variant_id")
  batchId           String?   @map("batch_id")
  voucherBatchId    String?   @map("voucher_batch_id")
  initialValue      Decimal   @map("initial_value")
  currentBalance    Decimal   @map("current_balance")
  currency          String    @default("LKR")
  status            String    @default("active") // 'active', 'redeemed', 'expired', 'cancelled', 'suspended'
  issuedAt          DateTime  @default(now()) @map("issued_at")
  expiresAt         DateTime? @map("expires_at")
  activatedAt       DateTime? @map("activated_at")
  fullyRedeemedAt   DateTime? @map("fully_redeemed_at")
  customerId        String?   @map("customer_id")
  orderId           String?   @map("order_id")
  purchaseReference String?   @map("purchase_reference")
  notes             String?
  createdBy         String?   @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")

  sku          SKU                 @relation(fields: [skuId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  variant      SKUVariant?         @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  batch        Batch?              @relation(fields: [batchId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  voucherBatch VoucherBatch?       @relation(fields: [voucherBatchId], references: [id], onDelete: SetNull, onUpdate: NoAction)
