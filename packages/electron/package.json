{
  "name": "@jingles/electron",
  "version": "1.0.2",
  "main": "dist/electron/main.js",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/write-build-info.mjs electron && concurrently \"tsc -w\" \"wait-on dist/electron/main.js http://localhost:5173 && node scripts/launch-electron.cjs .\"",
    "build": "node ../../scripts/write-build-info.mjs electron && tsc",
    "build:electron": "node scripts/verify-package-inputs.cjs && electron-builder",
    "start": "node ../../scripts/write-build-info.mjs electron && node scripts/launch-electron.cjs .",
    "test": "node ../../scripts/write-build-info.mjs electron && vitest run",
    "test:watch": "node ../../scripts/write-build-info.mjs electron && vitest",
    "test:coverage": "node ../../scripts/write-build-info.mjs electron && vitest run --coverage"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.0",
    "vite": "8.0.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.10.6",
    "@types/uuid": "^9.0.7",
    "concurrently": "^8.2.2",
    "electron": "^38.8.6",
    "electron-builder": "^26.8.1",
    "electronmon": "^2.0.4",
    "nodemon": "^3.1.14",
    "typescript": "^5.3.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.jingles.inventory",
    "productName": "Jingles Inventory",
    "electronVersion": "38.8.6",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web/dist"
      },
      {
        "from": "../backend/dist",
        "to": "backend/dist"
      },
      {
        "from": "../backend/prisma",
        "to": "backend/prisma"
      },
      {
        "from": "../backend/generated",
        "to": "backend/generated"
      }
    ],
    "mac": {
      "category": "public.app-category.business"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
