{
  "name": "@jingles/electron",
  "version": "1.0.0",
  "main": "dist/electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently \"tsc -w\" \"wait-on dist/electron/main.js http://localhost:5173 && electron .\"",
    "build": "tsc",
    "build:electron": "electron-builder",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "better-sqlite3": "^12.6.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@shopify/polaris-types": "^1.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.10.6",
    "@types/uuid": "^9.0.7",
    "concurrently": "^8.2.2",
    "electron": "28.3.3",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.jingles.inventory",
    "productName": "Jingles Inventory",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.business"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
