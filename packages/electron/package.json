{
  "name": "jingles-inventory-desktop",
  "version": "1.0.3",
  "description": "Offline-capable Jingles Inventory desktop application",
  "main": "dist/electron/main.js",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/write-build-info.mjs electron && concurrently \"tsc -w\" \"wait-on dist/electron/main.js http://localhost:5173 && node scripts/launch-electron.cjs .\"",
    "build": "node ../../scripts/write-build-info.mjs electron && tsc",
    "build:electron": "node scripts/verify-package-inputs.cjs && electron-builder",
    "build:update": "node scripts/verify-package-inputs.cjs && node scripts/build-update.cjs JINGLES_INVENTORY_UPDATE_URL",
    "start": "node ../../scripts/write-build-info.mjs electron && node scripts/launch-electron.cjs .",
    "test": "node ../../scripts/write-build-info.mjs electron && vitest run",
    "test:watch": "node ../../scripts/write-build-info.mjs electron && vitest",
    "test:coverage": "node ../../scripts/write-build-info.mjs electron && vitest run --coverage"
  },
  "dependencies": {
    "@jingles/shared": "*",
    "@prisma/client": "^5.7.1",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "electron-updater": "^6.8.9",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.21.0",
    "tesseract.js": "^7.0.0",
    "typesense": "^3.0.3",
    "uuid": "^9.0.0",
    "vite": "8.2.0",
    "winston": "^3.11.0",
    "ws": "^8.20.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.10.6",
    "@types/uuid": "^9.0.7",
    "concurrently": "^8.2.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.8.1",
    "electronmon": "^2.0.4",
    "nodemon": "^3.1.14",
    "typescript": "^5.3.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.jingles.inventory",
    "productName": "Jingles Inventory",
    "electronVersion": "38.8.6",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      {
        "from": "../../node_modules/.prisma",
        "to": "node_modules/.prisma",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "../web/dist",
        "to": "web/dist"
      },
      {
        "from": "../backend/dist",
        "to": "backend/dist"
      },
      {
        "from": "../backend/prisma",
        "to": "backend/prisma"
      },
      {
        "from": "../backend/generated",
        "to": "backend/generated"
      }
    ],
    "mac": {
      "category": "public.app-category.business"
    },
    "win": {
      "icon": "icon.ico",
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
